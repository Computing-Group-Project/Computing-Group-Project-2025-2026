# Environment variables for Demeter Smart Cafeteria System
# This file is optional for local development — docker-compose.yml provides defaults.
# For production, copy this to .env and fill in strong, random values.

# Database (default: demeter_root_pass)
MYSQL_ROOT_PASSWORD=your_secure_database_password_here

# JWT (must be 32+ characters; default: demeter-dev-jwt-secret-key-min-32chars)
JWT_SECRET=your_secure_jwt_secret_at_least_32_characters_long

# AI Service API Key (default: demeter-dev-api-key)
DEMETER_AI_API_KEY=your_secure_ai_api_key_here
